{
  "name": "@tsm/server",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "proto:gen:linux": "protoc --plugin=../node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,esModuleInterop=true,useDate=true,useExactTypes=false,stringEnums=true -I ../proto ../proto/node.proto ../proto/auth.proto",
    "proto:gen:windows": "protoc --plugin=../node_modules/.bin/protoc-gen-ts_proto.cmd --ts_proto_out=./src/generated --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,esModuleInterop=true,useDate=true,useExactTypes=false,stringEnums=true -I ../proto ../proto/node.proto ../proto/auth.proto",
    "dev": "npx tsx watch src/index.ts",
    "build": "tsc --build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.4",
    "grpc-tools": "^1.13.1",
    "ts-proto": "^2.12.0",
    "ts-protoc-gen": "^0.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@trpc/client": "11.4.3",
    "@trpc/server": "11.4.3",
    "@tsm/node": "*",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.0",
    "drizzle-zod": "^0.7.0",
    "eventsource": "^3.0.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4",
    "pg": "^8.13.1",
    "superjson": "^2.2.2",
    "trpc-to-openapi": "^2.3.2",
    "uuid": "^11.0.2",
    "zod": "^3.24.1",
    "zod-form-data": "^2.0.5"
  }
}
